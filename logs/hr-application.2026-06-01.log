2026-06-01 05:44:01.993 INFO  [c.a.config.SqlOnlyInterceptor] SQL Execute | mapper=com.ait.hrm.empinfo.mapper.HrEmployeeMapper.selectEmpMonthlyStats | caller=com.ait.hrm.empinfo.service.impl.HrEmployeeServiceImpl.getEmpMonthlyStats(HrEmployeeServiceImpl.java:196) | command=SELECT | params=[cpnyId='HTSV', cpnyId='HTSV', cpnyId='HTSV', year=2026, year=2026] | sql=SELECT m.MONTH_NUM, ( SELECT COUNT(*) FROM hr_employee e WHERE e.CPNY_ID = 'HTSV' AND TRUNC(e.DATE_STARTED) <= m.MONTH_END AND (e.DATE_LEFT IS NULL OR TRUNC(e.DATE_LEFT) > m.MONTH_END) ) AS EMP_COUNT, ( SELECT COUNT(*) FROM hr_employee n WHERE n.CPNY_ID = 'HTSV' AND TRUNC(n.DATE_STARTED) >= m.MONTH_START AND TRUNC(n.DATE_STARTED) <= m.MONTH_END ) AS NEW_JOINER_COUNT, ( SELECT COUNT(*) FROM hr_employee lv WHERE lv.CPNY_ID = 'HTSV' AND lv.DATE_LEFT IS NOT NULL AND TRUNC(lv.DATE_LEFT) >= m.MONTH_START AND TRUNC(lv.DATE_LEFT) <= m.MONTH_END ) AS LEAVER_COUNT FROM ( SELECT LEVEL AS MONTH_NUM, TRUNC(ADD_MONTHS(TO_DATE(TO_CHAR(2026) || '-01-01', 'YYYY-MM-DD'), LEVEL - 1), 'MM') AS MONTH_START, LAST_DAY(ADD_MONTHS(TO_DATE(TO_CHAR(2026) || '-01-01', 'YYYY-MM-DD'), LEVEL - 1)) AS MONTH_END FROM DUAL CONNECT BY LEVEL <= 12 ) m ORDER BY m.MONTH_NUM
