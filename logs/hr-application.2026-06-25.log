RENT_DEPT_NO UNION SELECT ASI.DEPTNO FROM AR_SUPERVISOR_INFO ASI WHERE ASI.DEPTNO = E.DEPTNO AND ASI.PERSON_ID = '11111112' ) ORDER BY A.CREATE_DATE DESC, E.EMPID
