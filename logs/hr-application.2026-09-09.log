2026-09-09 08:26:41.801 INFO  [c.a.config.SqlOnlyInterceptor] SQL Execute | mapper=com.ait.ess.viewDept.mapper.ManageCountInfoMapper.countByAge | caller=com.ait.ess.viewDept.service.impl.ManageCountInfoServiceImpl.getSummary(ManageCountInfoServiceImpl.java:33) | command=SELECT | params=[cpnyId='HAE', adminID='11111112', adminID='11111112', asOfDate='2026/09/09', asOfDate='2026/09/09'] | sql=SELECT SORT_NO AS CODE, AGE_GRP AS LABEL, COUNT(*) AS CNT FROM ( SELECT CASE WHEN HP.DOB IS NULL THEN '8' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) < 25 THEN '1' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 25 AND 30 THEN '2' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 31 AND 35 THEN '3' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 36 AND 40 THEN '4' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 41 AND 45 THEN '5' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 46 AND 50 THEN '6' ELSE '7' END AS SORT_NO, CASE WHEN HP.DOB IS NULL THEN 'Không xác định' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) < 25 THEN 'Dưới 25' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 25 AND 30 THEN '25 - 30' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 31 AND 35 THEN '31 - 35' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 36 AND 40 THEN '36 - 40' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 41 AND 45 THEN '41 - 45' WHEN TRUNC(MONTHS_BETWEEN(SYSDATE, HP.DOB) / 12) BETWEEN 46 AND 50 THEN '46 - 50' ELSE 'Trên 50' END AS AGE_GRP FROM HR_EMPLOYEE H, HR_DEPARTMENT D, HR_PERSONAL_INFO HP WHERE H.CPNY_ID = 'HAE' AND H.DEPTNO = D.DEPTNO(+) AND HP.PERSON_ID = H.PERSON_ID AND H.EMPID NOT LIKE '111111%' AND EXISTS ( SELECT B1.DEPTID FROM HR_DEPARTMENT B1 WHERE B1.DEPTNO = D.DEPTNO START WITH B1.DEPTNO IN ( SELECT HRD.DEPTID FROM HR_DEPARTMENT HRD WHERE HRD.MANAGER_EMP_ID = '11111112' ) CONNECT BY PRIOR B1.DEPTNO = B1.PARENT_DEPT_NO UNION SELECT ASI.DEPTNO FROM AR_SUPERVISOR_INFO ASI WHERE ASI.DEPTNO = D.DEPTNO AND ASI.PERSON_ID = '11111112' ) AND TRUNC(H.DATE_STARTED) <= TO_DATE('2026/09/09', 'YYYY/MM/DD') AND (H.DATE_LEFT IS NULL OR TRUNC(H.DATE_LEFT) >= TO_DATE('2026/09/09', 'YYYY/MM/DD')) ) GROUP BY SORT_NO, AGE_GRP ORDER BY SORT_NO
